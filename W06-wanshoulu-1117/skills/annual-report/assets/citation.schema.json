{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "引用条目 JSON Schema —— writer 输出可机器校验；语义支持度仍由 check_citation.py 判定",
  "type": "object",
  "required": ["claim_id", "claim_text", "source_document_digest", "page", "evidence_excerpt", "evidence_excerpt_digest"],
  "additionalProperties": false,
  "properties": {
    "claim_id": {"type": "string", "pattern": "^C-[0-9]+$"},
    "claim_text": {"type": "string", "minLength": 4, "maxLength": 200},
    "source_document_digest": {"type": "string", "minLength": 8},
    "page": {"type": "integer", "minimum": 1},
    "evidence_excerpt": {"type": "string", "minLength": 4, "maxLength": 120},
    "evidence_excerpt_digest": {"type": "string", "minLength": 8}
  }
}
