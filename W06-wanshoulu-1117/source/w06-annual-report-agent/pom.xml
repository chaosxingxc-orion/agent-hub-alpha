<?xml version="1.0" encoding="UTF-8"?>
<!--
  W06 Annual Report Agent — parent POM
  依赖 openJiuwen agent-solution 固定快照 bf702bc95064d3491cf8b374f54d271363d84230。
  版本号与上游 common/pom.xml 对齐（见 versions.lock）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.agenthub.w06</groupId>
    <artifactId>w06-annual-report-agent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>W06 Annual Report Agent (Issue #16)</name>

    <modules>
        <module>agent-orchestrator</module>
        <module>agents</module>
        <module>checker</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- openJiuwen agent-solution 固定快照（versions.lock） -->
        <agent-solution.revision>bf702bc95064d3491cf8b374f54d271363d84230</agent-solution.revision>
        <agent-core-java.version>0.1.17</agent-core-java.version>
        <agent-runtime-java.version>0.1.4</agent-runtime-java.version>
        <jackson.version>2.17.2</jackson.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 上游 agent-core-java：DeepAgent / ReActAgent / Rail / AgentCard -->
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-core-java</artifactId>
                <version>${agent-core-java.version}</version>
            </dependency>
            <!-- agent-core-ext-react-rails：CriteriaReplanBridgeRail / RootCauseRail -->
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-core-ext-react-rails</artifactId>
                <version>0.1.3</version>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-core-memory-java</artifactId>
                <version>0.1.16</version>
            </dependency>
            <!-- runtime 可运行构件（agent-runtime-java 是聚合 pom，真正构件是 agent-service-*） -->
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-service-app</artifactId>
                <version>0.1.4</version>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-service-adapters-agentcore-ext</artifactId>
                <version>0.1.3</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
